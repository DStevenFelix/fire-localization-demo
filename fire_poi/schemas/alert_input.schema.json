{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alert_input.schema.json",
  "title": "CurrentMapFireAlert",
  "type": "object",
  "required": [
    "event_id",
    "alert_level",
    "content",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "alert_level": {
      "type": "string",
      "enum": [
        "emergency",
        "medium",
        "suspected"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reporter": {
      "type": "object",
      "properties": {
        "resident_id": {
          "type": "string",
          "minLength": 1
        },
        "current_poi_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_location_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "upstream_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
