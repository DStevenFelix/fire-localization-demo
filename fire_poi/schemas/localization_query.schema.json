{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localization_query.schema.json",
  "title": "NormalizedCurrentMapQuery",
  "type": "object",
  "required": [
    "event_type"
  ],
  "properties": {
    "event_type": {
      "const": "fire"
    },
    "explicit_target": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "poi_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "Tank",
            "Building",
            "Facility"
          ]
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "poi_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "spatial_relation": {
      "enum": [
        null,
        "near",
        "adjacent_to",
        "opposite",
        "across_road",
        "north",
        "south",
        "east",
        "west",
        "northeast",
        "northwest",
        "southeast",
        "southwest"
      ]
    },
    "distance": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "simulation_unit"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "road_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "area_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "nearest": {
      "type": "boolean"
    },
    "raw_text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
