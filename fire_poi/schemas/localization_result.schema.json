{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localization_result.schema.json",
  "title": "CurrentMapLocalizationResult",
  "type": "object",
  "required": [
    "event_id",
    "status",
    "confidence",
    "confidence_kind",
    "location",
    "candidates",
    "evidence",
    "normalized_query",
    "model_version",
    "coordinate_system",
    "unit"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "located",
        "ambiguous",
        "not_found",
        "invalid"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_kind": {
      "const": "heuristic_not_calibrated"
    },
    "location": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "poi_id",
            "name",
            "x",
            "y",
            "area_id"
          ],
          "properties": {
            "poi_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            },
            "area_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "poi_id",
          "name",
          "x",
          "y",
          "score"
        ],
        "properties": {
          "poi_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 25
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized_query": {
      "type": [
        "object",
        "null"
      ]
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_system": {
      "const": "LOCAL30x25"
    },
    "unit": {
      "const": "simulation_unit"
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "located"
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "type": "object",
            "required": [
              "poi_id",
              "name",
              "x",
              "y",
              "area_id"
            ],
            "properties": {
              "poi_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 30
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 25
              },
              "area_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "location": {
            "type": "null"
          }
        }
      }
    }
  ]
}
