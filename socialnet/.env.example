# Copy this file to .env and fill in your key there.
# No key: simulation stays paused; there is no local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SIMULATION_INTERVAL_SECONDS=3
# 仅联动发帖服务使用。每个发布窗口最多交付 5 条初筛火情帖。
POST_SOURCE_PUBLISH_SECONDS=10
# Shared by resident and monitoring models; outer deadline is this value + 5s.
LLM_REQUEST_TIMEOUT_SECONDS=90
# Monitoring only. Qwen3.8: low (default), medium, xhigh; default omits the parameter.
# Other model families keep their provider defaults. Resident settings are unchanged.
MONITOR_REASONING_EFFORT=low

# Localization Chat reuses the existing resident/monitor provider and key.
LOCALIZATION_REASONING_EFFORT=low
# Configure a separately authorized OpenAI-compatible embedding endpoint.
# No provider or model is guessed, and there is no offline fallback.
LOCALIZATION_EMBEDDING_API_KEY=
LOCALIZATION_EMBEDDING_BASE_URL=
LOCALIZATION_EMBEDDING_MODEL=
